# Pin this to a tested release tag or image digest before production use.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable

# Generate random hex values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_long_random_hex_secret
LITELLM_MASTER_KEY=sk-replace_with_a_long_random_hex_secret

# Set a provider key before making requests to the starter model in config.yaml.
OPENAI_API_KEY=
