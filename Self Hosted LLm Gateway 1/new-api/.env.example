# Pin this to a tested release tag or image digest before production use.
NEW_API_IMAGE=calciumion/new-api:latest

# Generate unique random hex values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_long_random_hex_secret
REDIS_PASSWORD=replace_with_a_different_long_random_hex_secret
SESSION_SECRET=replace_with_another_long_random_hex_secret

# Exact external HTTPS origin used by the reverse proxy, no trailing slash.
PUBLIC_ORIGIN=https://new-api.example.com
TZ=UTC
